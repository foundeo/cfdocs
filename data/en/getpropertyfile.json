{
	"name": "getPropertyFile",
	"type": "function",
	"syntax": "getPropertyFile(filepath [, encoding])",
	"returns": "struct",
	"related": [
		"getPropertyString",
		"setPropertyString",
		"getProfileString"
	],
	"description": "Reads a Java properties file and returns all of its key-value pairs as a struct.",
	"params": [
		{
			"name": "filepath",
			"description": "Absolute path to the properties file.",
			"required": true,
			"default": "",
			"type": "string",
			"values": []
		},
		{
			"name": "encoding",
			"description": "Character encoding of the file.",
			"required": false,
			"default": "utf-8",
			"type": "string",
			"values": []
		}
	],
	"engines": {
		"coldfusion": {
			"minimum_version": "2025",
			"notes": "",
			"docs": "https://guides.adobe.com/coldfusion/en/docs/cfml-reference/getpropertyfile.html"
		}
	},
	"links": [],
	"examples": [
		{
			"title": "Read a properties file",
			"description": "",
			"code": "path = getTempDirectory() & \"app.properties\";\nfileWrite(path, \"a=1#chr(10)#b=hello\");\nwriteOutput(serializeJSON(getPropertyFile(path)));",
			"result": "{\"a\":\"1\",\"b\":\"hello\"}"
		}
	]
}

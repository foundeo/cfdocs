{
	"name": "getPropertyString",
	"type": "function",
	"syntax": "getPropertyString(filepath, key [, encoding])",
	"returns": "string",
	"related": [
		"getPropertyFile",
		"setPropertyString",
		"getProfileString"
	],
	"description": "Returns the value of one key in a Java properties file. Returns an empty string if the key is not defined.",
	"params": [
		{
			"name": "filepath",
			"description": "Absolute path to the properties file.",
			"required": true,
			"default": "",
			"type": "string",
			"values": []
		},
		{
			"name": "key",
			"description": "The key to look up.",
			"required": true,
			"default": "",
			"type": "string",
			"values": []
		},
		{
			"name": "encoding",
			"description": "Character encoding of the file.",
			"required": false,
			"default": "utf-8",
			"type": "string",
			"values": []
		}
	],
	"engines": {
		"coldfusion": {
			"minimum_version": "2025",
			"notes": "",
			"docs": "https://guides.adobe.com/coldfusion/en/docs/cfml-reference/getpropertystring.html"
		},
		"lucee": {
			"minimum_version": "7.0.0.108",
			"notes": "",
			"docs": "https://docs.lucee.org/reference/functions/getpropertystring.html"
		}
	},
	"links": [],
	"examples": [
		{
			"title": "Read one value",
			"description": "",
			"code": "path = getTempDirectory() & \"app.properties\";\nfileWrite(path, \"a=1#chr(10)#b=hello\");\nwriteOutput(getPropertyString(path, \"b\"));",
			"result": "hello"
		}
	]
}
